# Datasets are provided by the competition and must never be committed.
data/*
!data/.gitkeep

# Competition archive and the extracted training files (local only, ~2.4 GB).
dataset/

# Scratch working directory: extracted data, logs, intermediate artifacts.
experiments/work_match_a2/

# Model artifacts and caches produced by the experiment runners.
experiments/checkpoints/

# Generated outputs (candidate pairs, submission files, reports).
output/*
!output/.gitkeep

# Model artifacts and caches.
*.pkl
*.pickle
*.joblib
*.parquet
*.feather
*.h5
*.npy
*.npz
.cache/

# Python caches and build artifacts.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Virtual environments.
.venv/
venv/
env/
ENV/

# Editors and OS files.
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Secrets and local configuration.
.env
.env.*
*.pem
*.key
*credentials*
*secrets*
local_settings.py
AGENTS.md
